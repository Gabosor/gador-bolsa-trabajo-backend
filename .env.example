# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

PORT=4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=bolsa_trabajo_gador

# JWT (genera un valor largo y aleatorio)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Usuario SuperAdmin creado por el seed
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 (bucket privado)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# OTP: "demo" muestra el código en pantalla; "whatsapp" lo envía con Evolution API v2
OTP_MODE=demo
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Correo SMTP
SMTP_HOST=
# 465 usa TLS directo; 587, STARTTLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Web Push (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Contraseña de las cuentas de ejemplo creadas por npm run seed:demo
DEMO_PASSWORD=
